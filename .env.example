# .env.example (copy to .env)
#
# This file is a template (safe to commit). Your real `.env` is gitignored.
#

# Timezone for containers
TZ=Europe/Stockholm

# Bind UI ports on the host (Tailscale interface).
# Set this to your Windows host's Tailscale IPv4 (100.x.y.z).
# We also publish the same UIs on 127.0.0.1 for local browser testing (mic works on localhost without HTTPS).
UI_BIND_ADDR=100.123.45.67

# Reolink camera LAN details
CAMERA_HOST=192.168.1.50
CAMERA_USER=admin
CAMERA_PASS=CHANGE_ME

# Reolink E1 / E1 Pro RTSP paths (common defaults)
RTSP_MAIN_PATH=/h264Preview_01_main
RTSP_SUB_PATH=/h264Preview_01_sub

# Frigate detection defaults for sub-stream
# Lower resolution + lower FPS = less CPU/GPU usage.
DETECT_WIDTH=640
DETECT_HEIGHT=360
DETECT_FPS=5
# 0 = phone/live uses only Main stream (highest quality/FPS), 1 = expose Sub too.
FRIGATE_LIVE_INCLUDE_SUB=0

# Retention (days)
# - FRIGATE_EVENT_RETAIN_DAYS: how many days to keep "alert/detection" recording segments
# - FRIGATE_SNAPSHOT_RETAIN_DAYS: how many days to keep snapshots
# - FRIGATE_SNAPSHOTS_ENABLED: 0/1 to disable/enable still images from Frigate events
# - FRIGATE_RECORD_AUDIO_PRESET: ffmpeg preset for record output audio handling
FRIGATE_EVENT_RETAIN_DAYS=7
FRIGATE_SNAPSHOT_RETAIN_DAYS=7
FRIGATE_SNAPSHOTS_ENABLED=0
FRIGATE_RECORD_AUDIO_PRESET=preset-record-generic-audio-aac

# Wyoming (Home Assistant Assist)
# - Whisper: Speech-to-Text
# - Piper: Text-to-Speech
# - OpenWakeWord: Wake word detection
#
# Important limitation:
# These services create/consume audio data locally, but this project does not yet "wire" audio input/output
# devices (mic/speaker) automatically. Home Assistant will be the component that orchestrates voice pipelines.
WHISPER_MODEL=small-int8
WHISPER_LANG=sv
# Swedish voices vary by image/version. If this voice fails, check logs and pick another, e.g. en_US-lessac-medium.
PIPER_VOICE=sv_SE-nst-medium
WAKEWORD_MODEL=hey_jarvis

# Script helpers
# Must match the camera key in the rendered Frigate config (cameras.<name>).
# Keep this default key unless you also change stream names like `reolink_e1pro_main`.
CAMERA_NAME=reolink_e1pro

# Optional: Local LLM (Ollama) settings used by helper scripts + Home Assistant notes in README.
# Recommended for speed: run Ollama on the Windows host (uses RTX 4070) and have HA talk to it.
# If you bind Ollama to `0.0.0.0:11434`, use:
#   http://host.docker.internal:11434
# If you bind Ollama to your Tailscale IP (100.x.y.z), use:
#   http://100.x.y.z:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Chatterbox local TTS
CHATTERBOX_URL=http://chatterbox-tts:8000/tts
CHATTERBOX_MODEL=chatterbox
CHATTERBOX_VOICE=predefined
CHATTERBOX_RESPONSE_FORMAT=wav
CHATTERBOX_TIMEOUT_SEC=120

# Camera voice bridge (dynamic TTS -> camera speaker via RTSP push into go2rtc stream)
# Set token to restrict /v1/speak so only callers with this token can trigger speaker playback.
CAMERA_VOICE_BRIDGE_TOKEN=
CAMERA_VOICE_CHATTERBOX_URL=http://chatterbox-tts:8000/tts
CAMERA_VOICE_CHATTERBOX_TIMEOUT_SEC=90
CAMERA_VOICE_OUTPUT_MODE=go2rtc_api
CAMERA_VOICE_GO2RTC_API_BASE=http://go2rtc:1984
CAMERA_VOICE_GO2RTC_TIMEOUT_SEC=12
CAMERA_VOICE_RTSP_PUSH_BASE=rtsp://go2rtc:8554
CAMERA_VOICE_FFMPEG_TIMEOUT_SEC=90
CAMERA_VOICE_PUBLIC_BASE_URL=http://camera-voice-bridge:8091
CAMERA_VOICE_DEFAULT_STREAM=reolink_e1pro_main
CAMERA_VOICE_CODEC=pcmu
CAMERA_VOICE_GAIN_DB=14
CAMERA_VOICE_LANGUAGE=sv
CAMERA_VOICE_MODE=clone
CAMERA_VOICE_PREDEFINED_VOICE_ID=Alice.wav
CAMERA_VOICE_REFERENCE_AUDIO_FILENAME=sv_ref.wav
CAMERA_VOICE_AUDIO_RETENTION_SEC=900
CAMERA_VOICE_AUDIO_BRIDGE_URL=http://host.docker.internal:8092
# Shared secret for Windows audio_bridge.py (Authorization: Bearer ...).
CAMERA_VOICE_AUDIO_BRIDGE_TOKEN=
# Optional caller label for audit logs in audio_bridge.py.
CAMERA_VOICE_AUDIO_BRIDGE_CALLER=camera-voice-bridge
CAMERA_VOICE_SPEAK_MAX_LENGTH=4000

# Camera listener (mic in from camera RTSP -> local STT -> wake/turn to AIHub)
# Privacy: raw audio stays local and is not persisted by this service.
CAMERA_LISTENER_ENABLED=1
CAMERA_LISTENER_RTSP_URL=rtsp://go2rtc:8554/reolink_e1pro_main
CAMERA_LISTENER_DEVICE_ID=reolink_mic
CAMERA_LISTENER_AIHUB_URL=http://aihub:8080
# Optional bearer token for listener -> AIHub (use same as AIHUB_TOKEN if enabled)
CAMERA_LISTENER_AIHUB_TOKEN=
CAMERA_LISTENER_ALLOW_CODEX=1
CAMERA_LISTENER_WAKE_PHRASES=hej codex,hey codex
CAMERA_LISTENER_WAKE_ALIASES=hej codex,hey codex,hej kodex,hey kodex
CAMERA_LISTENER_STOP_PHRASES=stopp codex,stopp kodex,sluta codex,sluta kodex,stopp jarvis,sluta jarvis,sluta lyssna
CAMERA_LISTENER_STOP_ACK_TEXT=Okej, jag pausar.
CAMERA_LISTENER_IDLE_PHRASES=sov jarvis,vila jarvis,jarvis sov,jarvis vila
CAMERA_LISTENER_IDLE_ACK_TEXT=Okej, går till viloläge.
# Prefixes that interrupt speaking but keep the conversation active.
# Example: "vänta jarvis jag menar till stationen".
CAMERA_LISTENER_CORRECTION_PREFIXES=vänta jarvis,jarvis vänta,jag menar,jag menade,nej vänta,ändring
# Optional spoken ack when only correction prefix is said without extra content.
CAMERA_LISTENER_CORRECTION_ACK_TEXT=
CAMERA_LISTENER_STT_MODEL=small
CAMERA_LISTENER_STT_DEVICE=cpu
CAMERA_LISTENER_STT_COMPUTE_TYPE=int8
CAMERA_LISTENER_STT_LANGUAGE=sv
CAMERA_LISTENER_MODEL_DIR=/data/models
CAMERA_LISTENER_STT_BEAM_SIZE=5
CAMERA_LISTENER_STT_BEST_OF=5
CAMERA_LISTENER_STT_NO_SPEECH_THRESHOLD=0.6
CAMERA_LISTENER_STT_LOGPROB_THRESHOLD=-1.2
CAMERA_LISTENER_SEGMENT_MIN_AVG_LOGPROB=-0.9
CAMERA_LISTENER_SEGMENT_MAX_NO_SPEECH_PROB=0.6
CAMERA_LISTENER_WAKE_ONLY_MODE=1
CAMERA_LISTENER_WAKE_STT_MODEL=tiny
CAMERA_LISTENER_WAKE_STT_DEVICE=cpu
CAMERA_LISTENER_WAKE_STT_COMPUTE_TYPE=int8
CAMERA_LISTENER_WAKE_STT_LANGUAGE=sv
CAMERA_LISTENER_WAKE_STT_BEAM_SIZE=1
CAMERA_LISTENER_WAKE_STT_BEST_OF=1
CAMERA_LISTENER_WAKE_STT_NO_SPEECH_THRESHOLD=0.7
CAMERA_LISTENER_WAKE_STT_LOGPROB_THRESHOLD=-0.4
CAMERA_LISTENER_WAKE_SEGMENT_MIN_AVG_LOGPROB=-1.6
CAMERA_LISTENER_WAKE_SEGMENT_MAX_NO_SPEECH_PROB=0.98
CAMERA_LISTENER_WAKE_ALLOW_FUZZY_MATCH=0
CAMERA_LISTENER_SAMPLE_RATE=16000
CAMERA_LISTENER_CHUNK_SEC=1.8
CAMERA_LISTENER_MIN_DBFS=-52
CAMERA_LISTENER_MAX_PENDING_CHUNKS=3
CAMERA_LISTENER_VAD_MODE=2
CAMERA_LISTENER_VAD_FRAME_MS=30
CAMERA_LISTENER_VAD_START_FRAMES=3
CAMERA_LISTENER_VAD_END_FRAMES=14
CAMERA_LISTENER_VAD_PREROLL_FRAMES=6
CAMERA_LISTENER_VAD_MIN_SPEECH_MS=240
CAMERA_LISTENER_VAD_MAX_SPEECH_SEC=8
CAMERA_LISTENER_MIN_TEXT_LEN=3
CAMERA_LISTENER_WAKE_COOLDOWN_SEC=3
CAMERA_LISTENER_CONVERSATION_TTL_SEC=300
CAMERA_LISTENER_MIN_TURN_INTERVAL_SEC=1.2
CAMERA_LISTENER_DUPLICATE_WINDOW_SEC=8
CAMERA_LISTENER_ASSISTANT_ECHO_GUARD_SEC=5
CAMERA_LISTENER_ECHO_GRACE_SEC=0.3
CAMERA_LISTENER_ECHO_SIMILARITY_THRESHOLD=0.84
CAMERA_LISTENER_MIN_WORDS_FORWARD=2
CAMERA_LISTENER_FILLER_WORDS=ja,nej,okej,ok,tack,hej,dag,mm,mhm
CAMERA_LISTENER_DIRECTED_HINT_WORDS=codex,kan du,du,hjälp,hur,vad,varför,när,visa,berätta,påminn
CAMERA_LISTENER_DIRECTED_MIN_SCORE=1.2
CAMERA_LISTENER_FFMPEG_AUDIO_FILTER=highpass=f=100,lowpass=f=3700,volume=2.5
CAMERA_LISTENER_RECONNECT_DELAY_SEC=1.5
CAMERA_LISTENER_STATUS_PATH=/data/status.json
CAMERA_LISTENER_STATUS_HEARTBEAT_SEC=2
CAMERA_LISTENER_LOG_LEVEL=INFO
CAMERA_LISTENER_DEBUG_TRANSCRIPTS=0
CAMERA_LISTENER_HTTP_CONNECT_TIMEOUT_SEC=2
CAMERA_LISTENER_SPEAKER_STATE_TIMEOUT_SEC=1.5
CAMERA_LISTENER_WAKE_TIMEOUT_SEC=12
CAMERA_LISTENER_TURN_TIMEOUT_SEC=45
CAMERA_LISTENER_INTERRUPT_TIMEOUT_SEC=3
CAMERA_LISTENER_ANNOUNCE_TIMEOUT_SEC=5
CAMERA_LISTENER_LATENCY_WARN_STT_MS=1200
CAMERA_LISTENER_LATENCY_WARN_BARGE_STT_MS=900
CAMERA_LISTENER_LATENCY_WARN_SPEAKER_STATE_MS=180
CAMERA_LISTENER_LATENCY_WARN_WAKE_HTTP_MS=900
CAMERA_LISTENER_LATENCY_WARN_TURN_HTTP_MS=3500
CAMERA_LISTENER_LATENCY_WARN_INTERRUPT_HTTP_MS=500
CAMERA_LISTENER_WAKEWORD_ENGINE=openwakeword
CAMERA_LISTENER_OWW_MODEL=hey_jarvis
CAMERA_LISTENER_OWW_THRESHOLD=0.5
CAMERA_LISTENER_OWW_PLAYBACK_THRESHOLD=0.8
CAMERA_LISTENER_BARGE_IN_ENABLED=1
CAMERA_LISTENER_BARGE_IN_MIN_DBFS=-50
CAMERA_LISTENER_BARGE_IN_IGNORE_SPEAKER_SEC=4
CAMERA_LISTENER_BARGE_IN_INTERRUPT_SPEAKER=1
CAMERA_LISTENER_WAKE_INTERRUPT_DURING_PLAYBACK=0
CAMERA_LISTENER_BARGE_IN_REQUIRE_ACTIVE_CONVERSATION=0
CAMERA_LISTENER_BARGE_IN_REQUIRE_INTERRUPT_PHRASE=1
CAMERA_LISTENER_BARGE_IN_FREE_TURN_AFTER_WAKE_SEC=4.0
CAMERA_LISTENER_HARD_IDLE_INTERRUPT_COOLDOWN_SEC=0.8
CAMERA_LISTENER_HARD_IDLE_ACK_GRACE_SEC=1.2
CAMERA_LISTENER_INTERRUPT_PHRASES=stopp jarvis,stop jarvis,stopp codex,stopp kodex,hej jarvis,hey jarvis,hej codex,hey codex

# AI-hub (policy + routing + memory)
# Leave empty to disable API token auth on the internal Docker network.
AIHUB_TOKEN=
# local_first | codex_first
AIHUB_ROUTING_PROFILE=codex_first
# 0 = block camera-derived text to Codex unless explicit "Hey Codex", 1 = allow
AIHUB_ALLOW_CAMERA_TEXT_TO_CODEX=0
AIHUB_WAKE_PHRASES=hej codex,hey codex
AIHUB_WAKE_ACK_TEXT=Hej! Hur kan jag hjälpa dig?
# 1 = ignore audio turns unless they contain wake phrase or belong to active conversation TTL window.
AIHUB_AUDIO_REQUIRE_WAKE_OR_ACTIVE=1
AIHUB_CONVERSATION_TTL_SEC=300
# Vision task loop (snapshot -> VLM -> /v1/events/vision)
AIHUB_VISION_LOOP_ENABLED=1
AIHUB_VISION_LOOP_TICK_SEC=1.4
AIHUB_VISION_ACTIVITY_DEFAULT=workout
AIHUB_VISION_QUERY_OLLAMA_TIMEOUT_SEC=25
AIHUB_VISION_LOOP_OLLAMA_TIMEOUT_SEC=22
AIHUB_VISION_QUERY_ACK_TEXT=Jag tittar nu.
# Live video ingest (RTSP) used by vision loop.
AIHUB_VISION_VIDEO_ENABLED=1
AIHUB_VISION_VIDEO_RTSP_URL=rtsp://go2rtc:8554/reolink_e1pro_main
AIHUB_VISION_VIDEO_TARGET_FPS=9
AIHUB_VISION_VIDEO_MAX_STALE_SEC=1.8
AIHUB_VISION_VIDEO_RECONNECT_SEC=1.0
AIHUB_VISION_VIDEO_JPEG_QUALITY=80
# Rep analyzer mode: auto | cv | vlm
AIHUB_VISION_ANALYZER_MODE=auto
AIHUB_VISION_CV_ENABLED=1
AIHUB_VISION_CV_MIN_AMPLITUDE=0.09
AIHUB_VISION_CV_MIN_REP_INTERVAL_SEC=0.45
# Local software follow (smooth PTZ using live video)
AIHUB_SOFT_FOLLOW_ENABLED=1
AIHUB_SOFT_FOLLOW_USE_CAMERA_AUTOTRACK=0
AIHUB_SOFT_FOLLOW_TICK_SEC=0.34
AIHUB_SOFT_FOLLOW_MOVE_COOLDOWN_SEC=0.60
AIHUB_SOFT_FOLLOW_X_DEADZONE=0.18
AIHUB_SOFT_FOLLOW_Y_DEADZONE=0.25
AIHUB_SOFT_FOLLOW_FRAME_MAX_AGE_SEC=2.5
AIHUB_SOFT_FOLLOW_ENABLE_TILT=1
AIHUB_SOFT_FOLLOW_INVERT_X=0
AIHUB_SOFT_FOLLOW_INVERT_Y=0
AIHUB_SOFT_FOLLOW_MOTION_FALLBACK=0
AIHUB_SOFT_FOLLOW_MOTION_MIN_AREA_RATIO=0.004
AIHUB_SOFT_FOLLOW_LOST_SWEEP_AFTER_SEC=2.0
AIHUB_SOFT_FOLLOW_LOST_SWEEP_COOLDOWN_SEC=1.1
AIHUB_SOFT_FOLLOW_LOST_SWEEP_PATTERN=left,right,up,down
AIHUB_SOFT_FOLLOW_LOCK_LOST_AFTER_SEC=3.0
AIHUB_SOFT_FOLLOW_LOCK_REQUIRE_CONSECUTIVE=3
AIHUB_SOFT_FOLLOW_LOCK_ACK_AFTER_CONSECUTIVE=5
AIHUB_SOFT_FOLLOW_SWEEP_MAX_MOVES=6
AIHUB_SOFT_FOLLOW_SWEEP_PAUSE_SEC=8.0
AIHUB_SOFT_FOLLOW_RECOVER_MAX_MOVES=4
AIHUB_SOFT_FOLLOW_SMOOTHING_ALPHA=0.35
AIHUB_SOFT_FOLLOW_LOCK_ACK_TEXT=Jag hittade dig.
AIHUB_IDENTITY_RESOLVE_MIN_SCORE=0.82

# Companion personality — minimal mode verbal confirmations (default values shown)
AIHUB_MINIMAL_MODE_ON_ACK_TEXT=Okej, jag svarar kortare.
AIHUB_MINIMAL_MODE_OFF_ACK_TEXT=Okej, jag svarar som vanligt igen.

# Follow-up remark delay in seconds after workout stop (default: 1.5)
AIHUB_FOLLOWUP_DELAY_SEC=1.5

# Probability 0.0–1.0 that a follow-up remark fires after each workout stop (default: 0.30 = 30%)
AIHUB_FOLLOWUP_PROBABILITY=0.30
AIHUB_VISION_IDENTITY_PROMPT_COOLDOWN_SEC=12
AIHUB_VISION_PENDING_IDENTITY_TTL_SEC=90
AIHUB_VISION_TTS_MIN_INTERVAL_SEC=1.6
# 1 = allow CAMERA_LOOK from audio turns (voice can ask "vad ser du?").
AIHUB_ALLOW_AUDIO_CAMERA_LOOK=1
# 1 = if query asks for a person, CAMERA_LOOK performs an active PTZ sweep search.
AIHUB_CAMERA_LOOK_PERSON_SEARCH_ENABLED=1
# Sweep order for person search.
AIHUB_CAMERA_LOOK_PERSON_SEARCH_SWEEP=left,right,up,down
# 1 = return to center before each sweep step so left/right/up/down are real quadrants.
AIHUB_CAMERA_LOOK_PERSON_SEARCH_RECENTER_EACH_STEP=1
# Extra settle after re-centering before next PTZ move.
AIHUB_CAMERA_LOOK_PERSON_SEARCH_RECENTER_SETTLE_SEC=1.1
AIHUB_CAMERA_LOOK_PERSON_SEARCH_SETTLE_SEC=0.55
AIHUB_CAMERA_LOOK_PERSON_SEARCH_MIN_CONF=0.45
# Reset camera to center after search sweep.
AIHUB_CAMERA_LOOK_PERSON_SEARCH_RESET=1
# 1 = when "följ mig" starts, first try to locate/center the user before enabling follow.
AIHUB_CAMERA_FOLLOW_CENTER_ON_START=1
# Timeout per vision check during follow centering (seconds).
AIHUB_CAMERA_FOLLOW_CENTER_VISION_TIMEOUT_SEC=8
# 1 = return vision text directly (faster), 0 = ask Codex to rewrite vision answer.
AIHUB_CAMERA_LOOK_SKIP_CODEX_REWRITE=1
# 1 = reuse latest conversation_id on wake (persistent thread memory across wakes).
AIHUB_STICKY_CONVERSATION=1
# "audio" = reuse latest audio conversation, "any" = reuse latest regardless of source.
AIHUB_STICKY_CONVERSATION_SOURCE=audio
AIHUB_CODEX_URL=http://codex-gateway:8090/v1/ask
AIHUB_CODEX_TOKEN=
AIHUB_CODEX_TIMEOUT_SEC=120
# Codex context policy:
# 0 = fastest (thread-only), 1 = always include DB memory context.
AIHUB_CODEX_DB_CONTEXT_DEFAULT=0
# Allow DB context only on explicit memory/profile questions.
AIHUB_CODEX_DB_CONTEXT_ON_MEMORY_QUERY=1
AIHUB_CODEX_DB_CONTEXT_ON_PROFILE_QUERY=1
AIHUB_CODEX_DB_CONTEXT_LIMIT=10
AIHUB_CODEX_DB_CONTEXT_LIMIT_SEARCH=6
AIHUB_LATENCY_BUDGET_STT_TO_AIHUB_MS=1200
AIHUB_LATENCY_BUDGET_CODEX_MS=4500
AIHUB_LATENCY_BUDGET_CAMERA_ACTIONS_MS=1200
AIHUB_LATENCY_BUDGET_TURN_TOTAL_MS=6000
AIHUB_LATENCY_BUDGET_TTS_REQUEST_MS=1500
AIHUB_OLLAMA_BASE_URL=http://host.docker.internal:11434
AIHUB_OLLAMA_VISION_MODEL=llama3.2-vision
AIHUB_OLLAMA_TIMEOUT_SEC=30
AIHUB_OLLAMA_VISION_NUM_PREDICT=320
AIHUB_OLLAMA_MAX_IMAGE_EDGE=960
AIHUB_OLLAMA_JPEG_QUALITY=72
AIHUB_OLLAMA_RETRY_ON_TIMEOUT=1
AIHUB_REOLINK_PTZ_BURST_SEC=0.55
AIHUB_REOLINK_PTZ_SPEED=15
AIHUB_REOLINK_CHANNEL=0
AIHUB_GO2RTC_BASE_URL=http://go2rtc:1984
AIHUB_SNAPSHOT_STREAM=reolink_e1pro_main
AIHUB_SNAPSHOT_TIMEOUT_SEC=5
AIHUB_SNAPSHOT_RETRIES=2
AIHUB_CAMERA_SPEAK_ENABLED=0
AIHUB_CAMERA_SPEAK_URL=http://camera-voice-bridge:8091/v1/speak
AIHUB_CAMERA_SPEAK_TOKEN=
AIHUB_CAMERA_SPEAK_TIMEOUT_SEC=20
AIHUB_CAMERA_SPEAK_SOURCE_FILTER=audio
AIHUB_CAMERA_SPEAK_MAX_CHARS=3600
# Comma-separated events: reply, wake_ack, processing_ack
# Set to "reply" if you only want final assistant answers on the speaker.
AIHUB_CAMERA_SPEAK_EVENTS=reply,wake_ack,processing_ack
AIHUB_CAMERA_SPEAK_STREAM=
# Optional: let aihub execute Home Assistant actions directly via HA REST API.
AIHUB_HA_BASE_URL=http://homeassistant:8123
AIHUB_HA_TOKEN=
# Comma-separated HA entity IDs for voice light control (R15 route).
# Example: light.krona1,light.krona2,light.krona3
AIHUB_LIGHT_ENTITIES=
# Service in domain.service format (e.g. notify.mobile_app_iphone, persistent_notification.create)
AIHUB_HA_NOTIFY_SERVICE=persistent_notification.create
# Optional for R2 dance route:
AIHUB_HA_SPOTIFY_ENTITY_ID=
AIHUB_DANCE_SPOTIFY_URI=

# Codex Gateway (text-only brain endpoint)
# Default: Codex CLI OAuth/device-auth (no API key needed).
CODEX_GATEWAY_BACKEND=codex_cli
# Optional model override; if empty Codex CLI uses account/default model.
CODEX_MODEL=
# CLI behavior in gateway container.
CODEX_TIMEOUT_SEC=60
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_APPROVAL=never
CODEX_CLI_ENABLE_SEARCH=1
CODEX_CLI_BIN=codex
# Context budget for Codex CLI prompt (fewer = faster).
CODEX_MEMORY_LIMIT=8
CODEX_MEMORY_LIMIT_SEARCH=4
# Optional: persistence for conversation_id -> Codex thread_id mapping used by `codex exec resume`.
CODEX_THREAD_MAP_FILE=/root/.codex/conversation_threads.json
# Optional fallback: direct API-key backend (`CODEX_GATEWAY_BACKEND=openai`)
OPENAI_API_KEY=
# Optional internal token between aihub and codex-gateway
CODEX_GATEWAY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# face-recognition service (InsightFace buffalo_l — GPU required)
# ─────────────────────────────────────────────────────────────────────────────
# Shared API key between ai-hub and face-recognition service.
# Generate with: openssl rand -hex 24
FACE_RECOGNITION_API_KEY=change-me-strong-secret
# Cosine similarity threshold for identity match (0.0–1.0; lower = looser matching).
FACE_RECOGNITION_THRESHOLD=0.55

# ─────────────────────────────────────────────────────────────────────────────
# ai-hub: arrival flow + face recognition integration
# ─────────────────────────────────────────────────────────────────────────────
# Internal URL of the face-recognition service (Docker network).
AIHUB_FACE_RECOGNITION_URL=http://face-recognition:8082
# Cosine threshold override for ai-hub (defaults to face-recognition service threshold).
AIHUB_FACE_RECOGNITION_THRESHOLD=0.55
# Seconds after last greeting before a new arrival greeting fires (default: 2 hours).
AIHUB_ARRIVAL_COOLDOWN_SEC=7200
# Seconds between "vem är du?" prompts for unknown persons (default: 24 hours).
AIHUB_UNKNOWN_PERSON_COOLDOWN_SEC=86400

# ─────────────────────────────────────────────────────────────────────────────
# ai-hub: PTZ gesture body language
# ─────────────────────────────────────────────────────────────────────────────
# 1 = enable camera gestures (nod/shake/thinking) during conversations.
AIHUB_PTZ_GESTURES_ENABLED=0
# PTZ speed for nod gesture (1–63).
AIHUB_PTZ_NOD_SPEED=10
# PTZ speed for head-shake gesture (1–63).
AIHUB_PTZ_SHAKE_SPEED=10
# Duration of each nod/shake move step in seconds.
AIHUB_PTZ_NOD_DURATION_SEC=0.35
AIHUB_PTZ_SHAKE_DURATION_SEC=0.3

# ─────────────────────────────────────────────────────────────────────────────
# ai-hub: memory extraction
# ─────────────────────────────────────────────────────────────────────────────
# 1 = extract facts from conversations and store in memory_facts table.
AIHUB_MEMORY_EXTRACTION_ENABLED=0

# ─────────────────────────────────────────────────────────────────────────────
# ai-hub: proactive companion
# ─────────────────────────────────────────────────────────────────────────────
# 1 = enable unprompted AI initiations (morning greeting, follow-ups).
AIHUB_PROACTIVE_ENABLED=0
# Time of day for morning greeting (HH:MM, 24-hour, local TZ).
AIHUB_MORNING_GREETING_TIME=07:00

# ─────────────────────────────────────────────────────────────────────────────
# Desk presence tracking (004-presence-tracking)
# Polls HA person sensor to track away-trips from the desk.
# ─────────────────────────────────────────────────────────────────────────────
# 1 = enable presence tracking; 0 = disable (no polling, no DB writes).
AIHUB_PRESENCE_ENABLED=1
# HA entity ID for the Reolink person sensor.
AIHUB_PRESENCE_ENTITY=binary_sensor.living_room_person
# How often to poll HA for sensor state (seconds).
AIHUB_PRESENCE_POLL_SEC=5
# Trips shorter than this are discarded as sensor noise (seconds).
AIHUB_PRESENCE_MIN_TRIP_SEC=60
# Trips longer than this are stored but excluded from desk-break stats (seconds, default = 4 h).
AIHUB_PRESENCE_MAX_TRIP_SEC=14400
# Unbroken sitting streak that triggers a spontaneous comment (seconds, default = 2 h).
AIHUB_PRESENCE_SITTING_ALERT_SEC=7200


# ─────────────────────────────────────────────────────────────────────────────
# SL departure board (/departures)
# ─────────────────────────────────────────────────────────────────────────────
# Trafiklab "SL Realtidsinformation 4" API key (for departures table)
TRAFIKLAB_REALTIME_KEY=
# Trafiklab "GTFS Regional Realtime" API key (for vehicle positions on map)
TRAFIKLAB_GTFS_REALTIME_KEY=
# Trafiklab "GTFS Regional" (static) API key — needed for line numbers on map
